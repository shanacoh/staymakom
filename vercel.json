{
  "redirects": [
    {
      "source": "/hotel-old/:slug",
      "destination": "/hotel/:slug",
      "permanent": true
    },
    {
      "source": "/experience-old/:slug",
      "destination": "/experience/:slug",
      "permanent": true
    },
    {
      "source": "/experiences-old",
      "destination": "/experiences",
      "permanent": true
    },
    {
      "source": "/hotel/bayit-bagalil-boutique-hotel-by-herbert-samuelnn",
      "destination": "/hotel/bayit-bagalil-boutique-hotel-by-herbert-samuel",
      "permanent": true
    },
    {
      "source": "/experience2/:slug",
      "destination": "/experience/:slug",
      "statusCode": 301
    },
    {
      "source": "/hotels/:slug",
      "destination": "/hotel/:slug",
      "statusCode": 301
    },
    {
      "source": "/experiences2",
      "destination": "/experiences",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/billet/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/llms.txt",
      "destination": "/api/llms"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!.*\\.).+)",
      "destination": "/index.html"
    }
  ]
}
