{
  "redirects": [
    {
      "source": "/ig",
      "destination": "/?utm_source=instagram&utm_medium=social&utm_campaign=bio",
      "permanent": false
    },
    {
      "source": "/tt",
      "destination": "/?utm_source=tiktok&utm_medium=social&utm_campaign=bio",
      "permanent": false
    },
    {
      "source": "/li",
      "destination": "/?utm_source=linkedin&utm_medium=social&utm_campaign=page",
      "permanent": false
    },
    {
      "source": "/wa",
      "destination": "/?utm_source=whatsapp&utm_medium=social&utm_campaign=profile",
      "permanent": false
    },
    {
      "source": "/hotel-old/:slug",
      "destination": "/hotel/:slug",
      "permanent": true
    },
    {
      "source": "/experience-old/:slug",
      "destination": "/experience/:slug",
      "permanent": true
    },
    {
      "source": "/experiences-old",
      "destination": "/experiences",
      "permanent": true
    },
    {
      "source": "/hotel/bayit-bagalil-boutique-hotel-by-herbert-samuelnn",
      "destination": "/hotel/bayit-bagalil-boutique-hotel-by-herbert-samuel",
      "permanent": true
    },
    {
      "source": "/experience2/:slug",
      "destination": "/experience/:slug",
      "statusCode": 301
    },
    {
      "source": "/hotels/:slug",
      "destination": "/hotel/:slug",
      "statusCode": 301
    },
    {
      "source": "/experiences2",
      "destination": "/experiences",
      "statusCode": 301
    },
    {
      "source": "/journal/hanukkah-in-israel-2026",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "he"
        }
      ],
      "destination": "/journal/matana-lezug-chanuka?lang=he",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/billet/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/llms.txt",
      "destination": "/api/llms"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!.*\\.).+)",
      "destination": "/index.html"
    }
  ]
}
